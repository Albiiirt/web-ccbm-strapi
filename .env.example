HOST=0.0.0.0
PORT=1337
APP_KEYS="toBeModified1,toBeModified2"
API_TOKEN_SALT=tobemodified
ADMIN_JWT_SECRET=tobemodified
TRANSFER_TOKEN_SALT=tobemodified
JWT_SECRET=tobemodified
ENCRYPTION_KEY=tobemodified

# Base de dades — Postgres de Supabase (Project Settings > Database > Connection string, mode "Transaction")
DATABASE_CLIENT=postgres
DATABASE_URL=postgresql://postgres.xxxxxxxx:password@aws-0-eu-west-1.pooler.supabase.com:6543/postgres
DATABASE_SSL=true

# Media (fotos/vídeos) — bucket de Supabase Storage, exposat via la seva API S3-compatible
# (Project Settings > Storage > S3 Connection)
SUPABASE_S3_ENDPOINT=https://xxxxxxxx.supabase.co/storage/v1/s3
SUPABASE_S3_REGION=eu-west-1
SUPABASE_S3_BUCKET=strapi-uploads
SUPABASE_S3_ACCESS_KEY_ID=tobemodified
SUPABASE_S3_SECRET_ACCESS_KEY=tobemodified
SUPABASE_S3_PUBLIC_URL=https://xxxxxxxx.supabase.co/storage/v1/object/public/strapi-uploads
