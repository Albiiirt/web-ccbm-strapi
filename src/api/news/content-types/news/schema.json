{
  "kind": "collectionType",
  "collectionName": "news_items",
  "info": {
    "singularName": "news",
    "pluralName": "news-items",
    "displayName": "Notícia",
    "description": "Notícies de la web (abans gestionades a Notion)"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string",
      "required": true
    },
    "date": {
      "type": "date"
    },
    "category": {
      "type": "string"
    },
    "summary": {
      "type": "text"
    },
    "image": {
      "type": "media",
      "multiple": false,
      "allowedTypes": ["images"]
    },
    "url": {
      "type": "string"
    },
    "externalId": {
      "type": "string",
      "description": "ID original de Notion o 'local-...' per a migració idempotent"
    }
  }
}
